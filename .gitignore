# Log da tarefa agendada de auto-push (gerado em runtime, nao versionar)
.auto-push.log
.auto-push.log.old

# Backup file que ficou de uma execucao antiga
index.html.html

# Fonte pristina do artifact reconstruida em runtime pelo gerador de snapshot
_artifact_src.html

# Copia temporaria do Live Artifact usada para conferir sincronia com _artifact_src.html
_artifact_live_check.html

# Backups pontuais gravados durante a atualizacao do snapshot (nao versionar)
*.bak

# Backups datados (ex.: _gen_snapshot.py.bak-20260901)
*.bak-*

# Area de staging da geracao de 01/09/2026; os conjuntos definitivos ficam em _snap/
_snap09/
